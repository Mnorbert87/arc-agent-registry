# Arc Agent Registry configuration. Copy to .env and fill in.

# Deployed contract addresses (from contracts/script/Deploy.s.sol output).
ARC_IDENTITY_ADDRESS=
ARC_REPUTATION_ADDRESS=

# Signing key for writes (register, giveFeedback) and FeedbackAuth signatures.
# Reads work without it. Use a THROWAWAY testnet key only. Never a real-funds key.
ARC_PRIVATE_KEY=

# Network (defaults are Arc testnet; override only if needed).
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# Local index database.
ARC_REGISTRY_DB=arc_registry.db
